# ---- Public (safe to expose to the browser) ----
NEXT_PUBLIC_SITE_URL=https://ripple.studio
NEXT_PUBLIC_WHATSAPP_NUMBER=201042944136
NEXT_PUBLIC_INSTAGRAM_HANDLE=ripple___eg
# Turnstile/hCaptcha SITE key is public by design (the secret below is not).
NEXT_PUBLIC_CAPTCHA_SITE_KEY=

# ---- Server-only secrets (never prefix these with NEXT_PUBLIC_) ----
# Cloudflare Turnstile or hCaptcha secret key, used to verify tokens server-side.
CAPTCHA_SECRET_KEY=
# Comma-separated list of origins allowed to call the API routes cross-origin.
ALLOWED_ORIGINS=https://ripple.studio
# Random 32+ byte string, used to sign/verify anything session-like if auth is added later.
SESSION_SECRET=

# ---- Outbound mail for the contact form (optional but recommended) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
CONTACT_INBOX_EMAIL=hello@ripple.studio

# ---- Rate limiting backend (optional; falls back to in-memory single-instance limiter) ----
# If deploying to more than one server/edge instance, point this at Upstash Redis
# (or similar) so limits are enforced across instances, not just per-process.
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_REDIS_TOKEN=
